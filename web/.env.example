# SomnAI web — runtime configuration (all values ship to the browser).
#
# Leave VITE_BUTTERBASE_TOKEN empty to run in local demo mode (seeded data in
# the browser, no network). Provide a Butterbase token to enable live sync with
# the SomnAI iPhone app. The token can also be pasted in the in-app Settings.

# Butterbase Data + Storage API base (app is baked into the path).
VITE_BUTTERBASE_URL=https://api.butterbase.ai
VITE_BUTTERBASE_APP_ID=app_kf3crd1822g8

# bb_sk_… service key or a user JWT. Empty => demo mode.
VITE_BUTTERBASE_TOKEN=

# Optional table/bucket overrides (defaults match the iOS app).
VITE_BB_USERS_TABLE=users
VITE_BB_SLEEP_TABLE=sleep
VITE_BB_STRESS_TABLE=stress
