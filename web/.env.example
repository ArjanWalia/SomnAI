# SomnAI web-app environment configuration.
# Copy to `.env.local` and fill in. All values are exposed to the browser
# (Vite only inlines vars prefixed with VITE_), so never put secrets here —
# the Butterbase *publishable* (anon) key is safe; the service key is NOT.

# Butterbase app base URL (given for this project).
VITE_BUTTERBASE_URL=https://api.butterbase.ai/v1/app_kf3crd1822g8

# Butterbase publishable / anon API key (safe to ship to the browser).
# Row-level security on the Butterbase tables is what actually protects data.
VITE_BUTTERBASE_ANON_KEY=

# Names of the Butterbase tables and the video storage bucket. Defaults match
# docs/butterbase-schema.json — only change if you renamed them.
VITE_BB_USERS_TABLE=users
VITE_BB_SLEEP_TABLE=sleep_sessions
VITE_BB_STRESS_TABLE=stress_sessions
VITE_BB_VIDEO_BUCKET=stress-video
VITE_BB_AUDIO_BUCKET=session-audio
